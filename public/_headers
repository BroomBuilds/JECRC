# Cloudflare Pages / Workers reads this file; Node-served hosts read the
# headers() block in next.config.ts instead. Keep the two in step.

/media/tour/*
  Cache-Control: public, max-age=31536000, immutable

# Not /media/*: that would also match the tour above and, as the later rule,
# override its immutable header with a thirty-day one.
/media/stills/*
  Cache-Control: public, max-age=2592000

/brand/*
  Cache-Control: public, max-age=2592000

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
