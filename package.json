{
  "name": "jecrc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tour": "npm run tour:h && npm run tour:v",
    "tour:cuts": "node scripts/find-cuts.mjs",
    "tour:h": "node scripts/build-tour.mjs ref/website-horizontal.mp4 --fps 25 --widths 1400,640 --webp 1100 --crf 36 --stills 8 --out public/media/tour/h",
    "tour:v": "node scripts/build-tour.mjs ref/website-vertical_1.mp4 --fps 15 --widths 720,400 --webp 640 --crf 36 --stills 0 --out public/media/tour/v",
    "tour:build": "node scripts/build-tour.mjs",
    "brand:mono": "node scripts/make-mono-logo.mjs",
    "brand:crest": "node scripts/make-crest.mjs",
    "brand:social": "node scripts/make-social.mjs",
    "brand:icons": "node scripts/make-icons.mjs",
    "media": "node scripts/optimize-media.mjs",
    "media:dry": "node scripts/optimize-media.mjs --dry"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
